# Linux 服务器生产环境：前端直部署（Nginx 静态文件 + API 反代）
TZ=Asia/Shanghai

# 本地打包上传部署：SSH 主机（~/.ssh/config 别名或 root@IP）
SSH_HOST=aliyun
REMOTE_ENV_FILE=/data/ruoyi/.env.frontend.prod
REMOTE_DEPLOY_DIR=/data/ruoyi/deploy

WWW_ROOT=/data/ruoyi/www
NGINX_PORT=8080
NGINX_SITE=/etc/nginx/conf.d/ruoyi.conf

# 后端 Spring Boot 监听端口（与 dish-weixin-springboot3 的 SERVER_PORT 一致）
BACKEND_PORT=8082

# 代码根目录（可按服务器实际情况改为 $HOME/ruoyi）
RUOYI_HOME=/opt/ruoyi

# 前端仓库 https://github.com/Zhang-Yu-void/dish-weixin-vue3
FRONTEND_REPO=https://github.com/Zhang-Yu-void/dish-weixin-vue3.git
FRONTEND_DIR=/opt/ruoyi/dish-weixin-vue3

# 迁移时需停掉的旧前端容器名
DOCKER_FRONTEND_CONTAINER=vue-front-app
